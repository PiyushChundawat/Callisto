// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

  datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
  }

model PriceHistory {
  id        Int      @id @default(autoincrement())
  stockId   String
  price     Float
  timestamp DateTime @default(now())

  @@index([stockId, timestamp])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String?
  createdAt    DateTime @default(now())
}

model Watchlist {
  userId    String   @id
  stockIds  String[]
}

model UserPortfolio {
  userId         String @id
  currentBalance Float  @default(10000)
}

model PortfolioHolding {
  id          String  @id @default(cuid())
  userId      String
  stockId     String
  quantity    Float
  avgBuyPrice Float
  todayQty    Float   @default(0)
  todayDate   String?

  @@unique([userId, stockId])
}

model Order {
  id             String   @id @default(cuid())
  userId         String
  stockId        String
  side           String
  source         String?
  quantity       Float
  executedPrice  Float
  total          Float
  balanceAfter   Float
  status         String   @default("FILLED")
  tradeDate      String
  idempotencyKey String
  requestHash    String
  createdAt      DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}